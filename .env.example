# Backend
PORT=3001
DATABASE_URL=postgresql://siem_user:password@localhost:5432/siem_db
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=password
JWT_SECRET=replace-with-very-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-very-long-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANTHROPIC_API_KEY=
FRONTEND_URL=http://localhost:5173

# Syslog
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=siem-alerts@yourcompany.com

# GeoIP (optional)
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001