# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://siem_user:change-me-postgres-password@localhost:5432/siem_db
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=change-me-postgres-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANTHROPIC_API_KEY=
FRONTEND_URL=http://localhost:5173

# Syslog
# Container runs as non-root, so use high ports internally.
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
HOST_SYSLOG_UDP_PORT=5514

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=siem-alerts@yourcompany.com

# GeoIP (optional)
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
